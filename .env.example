DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email: keep the console backend for local demos; set EMAIL_HOST to use SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HireFlow <hiring@example.com>

# Optional SMS through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Optional OCR for scanned/image-only PDFs. Install Tesseract OCR separately,
# then set the executable path if it is not already available on PATH.
TESSERACT_CMD=

# Optional local semantic model. Download/cache this model once, then use its
# local directory here for offline SBERT matching. Leave blank for TF-IDF fallback.
SBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SBERT_LOCAL_PATH=

# Optional async invitation queue. Leave empty for synchronous local invitations.
CELERY_BROKER_URL=
INTERVIEW_CALENDAR_URL=
